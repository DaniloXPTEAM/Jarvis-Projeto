<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone da GABI: "G" estilizado em laranja claro sobre fundo escuro -->
<!-- Note: Android VectorDrawable does not support <circle> — circles are paths -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anel hexagonal externo (preenchimento translúcido) -->
    <path
        android:fillColor="#FFB347"
        android:fillAlpha="0.15"
        android:pathData="M54,12 L88,31 L88,69 L54,88 L20,69 L20,31 Z"/>

    <!-- Anel hexagonal interno (contorno) -->
    <path
        android:strokeColor="#FFB347"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M54,18 L84,35 L84,69 L54,86 L24,69 L24,35 Z"/>

    <!-- Letra "G" (arco + barra horizontal) em laranja claro -->
    <path
        android:strokeColor="#FFD9A0"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,38 A16,16 0 0,1 54,70 M70,54 L58,54"/>

    <!-- Ponto de destaque — círculo em (75,45) r=3 -->
    <path
        android:fillColor="#FFB347"
        android:pathData="M75,42 A3,3 0 1,0 75,48 A3,3 0 1,0 75,42 Z"/>
</vector>
