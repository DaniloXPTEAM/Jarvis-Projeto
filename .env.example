# ──────────────────────────────────────────────────────────────
#  JARVIS / NEXUS AI — variáveis de ambiente (TEMPLATE)
#  Copie este arquivo para ".env.local" e preencha SOMENTE no seu
#  computador / painel de deploy. NUNCA cole estes valores em chat.
# ──────────────────────────────────────────────────────────────

# ── OBRIGATÓRIO: banco de dados (PostgreSQL) ──────────────────
# Sem isto, Chat IA, Memória/Vault e logs de skill NÃO funcionam.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── IA (Claude / Anthropic) — Chat IA de verdade ──────────────
# Usado por /api/chat (rota principal). Pega em console.anthropic.com
ANTHROPIC_API_KEY=""

# (Legacy) rota /api/claude usa um nome diferente — mantenha os dois
# iguais se for usar essa rota separada.
CLAUDE_API_KEY=""

# ── Alexa (Echo) — anúncios/comandos de voz reais ─────────────
# Cookie + CSRF extraídos de alexa.amazon.com.br (login no navegador)
ALEXA_COOKIE=""
ALEXA_CSRF=""

# ── Home Assistant — casa inteligente real ────────────────────
# Ex.: http://192.168.0.10:8123  +  token de longa duração
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""

# ── Notícias reais (grátis) ───────────────────────────────────
# Pega em newsapi.org/register
NEWS_API_KEY=""

# ── Base pública do app (auto-chamada p/ Alexa) ───────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
